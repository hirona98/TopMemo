<Window x:Class="TopMemo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:viewModels="clr-namespace:TopMemo.App.ViewModels"
        mc:Ignorable="d"
        Title="TopMemo"
        Height="480"
        Width="720"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="8,8,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TabControl Name="MemoTabControl"
                        Grid.Column="0"
                        BorderThickness="1"
                        Background="White"
                        SelectionChanged="MemoTabControl_SelectionChanged"
                        PreviewMouseWheel="MemoTabControl_PreviewMouseWheel"
                        Margin="0,0,8,0">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:MemoTabViewModel}">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <EventSetter Event="PreviewMouseRightButtonDown"
                                     Handler="TabItem_PreviewMouseRightButtonDown" />
                    </Style>
                </TabControl.ItemContainerStyle>
            </TabControl>

            <Button Grid.Column="1"
                    Content="+"
                    Width="30"
                    Height="30"
                    Click="AddTabButton_Click" />
        </Grid>

        <Border Grid.Row="1"
                Margin="8,0,8,8"
                BorderBrush="#D0D0D0"
                BorderThickness="1">
            <avalonEdit:TextEditor Name="MemoEditor"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   ShowLineNumbers="False"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   PreviewMouseLeftButtonUp="MemoEditor_PreviewMouseLeftButtonUp" />
        </Border>
    </Grid>
</Window>
