<Window x:Class="TopMemo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:viewModels="clr-namespace:TopMemo.App.ViewModels"
        mc:Ignorable="d"
        Title="TopMemo"
        Height="480"
        Width="720"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="White"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- アクセント色を定義します。 -->
        <SolidColorBrush x:Key="AccentBrush"
                         Color="#4873CF" />

        <!-- タブ見た目を SettingWindow 風に揃えます。 -->
        <Style x:Key="AdminTabItemStyle"
               TargetType="TabItem">
            <Setter Property="Background"
                    Value="#F0F0F0" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="15,10" />
            <Setter Property="Foreground"
                    Value="#666666" />
            <Setter Property="Margin"
                    Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="White" />
                    <Setter Property="Foreground"
                            Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness"
                            Value="0,0,0,3" />
                    <Setter Property="BorderBrush"
                            Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ボタン見た目を SettingWindow 風に揃えます。 -->
        <Style x:Key="DisabledButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#4873CF" />
            <Setter Property="Foreground"
                    Value="WhiteSmoke" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Background"
                                        Value="#CCCCCC" />
                                <Setter Property="Foreground"
                                        Value="#888888" />
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#5A84D9" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#3A62B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- 下部に現在タブのファイルパスをステータスバー表示します。 -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="#F5F5F5"
                   BorderBrush="#E0E0E0"
                   BorderThickness="0,1,0,0">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock Name="CurrentPathTextBlock"
                           TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- メイン領域を余白なしで配置します。 -->
        <Grid Margin="0">
            <!-- 各タブの中にエディタを配置します。 -->
            <TabControl Name="MemoTabControl"
                        BorderThickness="0"
                        Background="White"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        AllowDrop="True"
                        SelectionChanged="MemoTabControl_SelectionChanged"
                        PreviewMouseLeftButtonDown="MemoTabControl_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="MemoTabControl_PreviewMouseMove"
                        DragOver="MemoTabControl_DragOver"
                        Drop="MemoTabControl_Drop"
                        PreviewMouseRightButtonDown="MemoTabControl_PreviewMouseRightButtonDown"
                        PreviewMouseWheel="MemoTabControl_PreviewMouseWheel"
                        Margin="0">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:MemoTabViewModel}">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem"
                           BasedOn="{StaticResource AdminTabItemStyle}">
                        <EventSetter Event="PreviewMouseRightButtonDown"
                                     Handler="TabItem_PreviewMouseRightButtonDown" />
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type viewModels:MemoTabViewModel}">
                        <Border BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                Background="White"
                                Margin="0">
                            <avalonEdit:TextEditor x:Name="TabMemoEditor"
                                                   Tag="{Binding}"
                                                   ShowLineNumbers="True"
                                                   Margin="0"
                                                   Padding="5"
                                                   Background="White"
                                                   Foreground="#1F2A44"
                                                   HorizontalScrollBarVisibility="Auto"
                                                   VerticalScrollBarVisibility="Auto"
                                                   Loaded="MemoEditor_Loaded"
                                                   Unloaded="MemoEditor_Unloaded"
                                                   PreviewMouseRightButtonDown="MemoEditor_PreviewMouseRightButtonDown"
                                                   PreviewMouseMove="MemoEditor_PreviewMouseMove"
                                                   PreviewMouseRightButtonUp="MemoEditor_PreviewMouseRightButtonUp"
                                                   LostMouseCapture="MemoEditor_LostMouseCapture"
                                                   PreviewMouseLeftButtonUp="MemoEditor_PreviewMouseLeftButtonUp" />
                        </Border>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- タブが無い場合だけ下部に使い方を表示します。 -->
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Margin="12,0,12,12"
                    Padding="12,10"
                    Background="#F7F9FC"
                    BorderBrush="#D9E1EF"
                    BorderThickness="1"
                    CornerRadius="6"
                    IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=MemoTabControl, Path=HasItems}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Foreground="#1F2A44"
                               FontWeight="SemiBold"
                               Text="タブがありません（最初に1つ作成してください）" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#4A5568"
                               Text="1. タブ行を右クリックします。" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="#4A5568"
                               Text="2. 「ファイルの作成」で新規メモを作るか、「ファイルを開く」で既存メモを開きます。" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="#4A5568"
                               Text="3. タブを右クリックすると「名前変更」「タブを閉じる」「ファイルを削除」が使えます。" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="#4A5568"
                               Text="4. トレイアイコン右クリックで「表示/非表示」「自動起動」「終了」を操作できます。" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
